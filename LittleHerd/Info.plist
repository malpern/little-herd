<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Little Herd</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Little Herd</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.24</string>
	<key>CFBundleVersion</key>
	<string>25</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<!-- A NAS answers on whatever name its owner typed, so ATS's domain list
	     cannot name it in advance, and the certificate it serves is usually one
	     it signed itself. ATS runs its own system-trust evaluation and refuses
	     that connection before the URLSession delegate is consulted, so the
	     pinning in SynologyTrustEvaluator never got a say — measured as "ATS
	     failed system trust" and NSURLErrorDomain -1200 against a NAS that was
	     answering. Lifting the blanket is what lets that delegate decide, and
	     the delegate is where the protection actually lives: trust on first
	     use, then a refusal if the key ever changes. The one host we do know
	     stays under ATS, because an exception still binds when arbitrary loads
	     are allowed — measured, not assumed. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>github.com</key>
			<dict>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>githubusercontent.com</key>
			<dict>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_ssh._tcp</string>
		<string>_smb._tcp</string>
	</array>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Little Herd discovers computers and storage on your local network so you can add them to your herd.</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://github.com/malpern/little-herd/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>4YXR9g0GN7tq3O6frg5sfkBWUhfioKXq6KuIP7xmdA8=</string>
</dict>
</plist>
