#!/bin/zsh
# Cut and publish a Little Herd release.
#
#   scripts/release <version> [--notes-file <path>] [--dry-run]
#
#   scripts/release 0.1.3
#   scripts/release 0.1.3 --notes-file /tmp/notes.md
#   scripts/release 0.1.3 --dry-run      # build and notarize, publish nothing
#
# Everything slow or failure-prone — building, testing, notarizing, signing the
# appcast — happens before anything irreversible. A failure during those steps
# leaves nothing but an uncommitted version bump, so the fix is to re-run rather
# than to unpick a half-published release.
#
# The appcast is not optional. Little Herd's feed is
# https://github.com/malpern/little-herd/releases/latest/download/appcast.xml,
# so a release published without appcast.xml makes that URL 404 and silently
# stops updates for every existing user. That is why it is built here rather
# than left as a step to remember.

set -euo pipefail

repo=malpern/little-herd
team=${LITTLE_HERD_TEAM_ID:-X2RKZ5TG99}
key_id=${LITTLE_HERD_ASC_KEY_ID:-XQ4565NYZ7}
issuer=${LITTLE_HERD_ASC_ISSUER:-60b8eb46-ca64-4580-a43b-850d92fcc7ab}
key_path=${LITTLE_HERD_ASC_KEY:-$HOME/.appstoreconnect/private_keys/AuthKey_$key_id.p8}

root=${0:a:h:h}
plist=$root/LittleHerd/Info.plist
notes_file=""
dry_run=0

die() { print -u2 "release: $1"; exit 1 }
step() { print "\n▸ $1" }

# ---------------------------------------------------------------- arguments

version=${1:-}
[ -n "$version" ] || die "usage: scripts/release <version> [--notes-file <path>] [--dry-run]"
shift

while [ $# -gt 0 ]; do
  case $1 in
    --notes-file) notes_file=${2:?--notes-file needs a path}; shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    *) die "unknown option: $1" ;;
  esac
done

[[ $version =~ '^[0-9]+\.[0-9]+(\.[0-9]+)?$' ]] \
  || die "version must look like 1.2 or 1.2.3, got “$version”"
[ -z "$notes_file" ] || [ -r "$notes_file" ] || die "cannot read notes file: $notes_file"

tag=v$version
cd "$root"

# ---------------------------------------------------------------- preflight
# Check everything the run depends on up front. Discovering halfway through a
# ten-minute notarization that gh is logged out is a waste of the ten minutes.

step "Preflight"

for tool in xcodegen xcodebuild gh git ditto xmllint; do
  command -v $tool >/dev/null || die "$tool is not installed"
done
if [ -n "$notes_file" ]; then
  command -v pandoc >/dev/null \
    || die "pandoc is needed to render release notes (brew install pandoc)"
fi

git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
[ -z "$(git status --porcelain)" ] || die "working tree is dirty; commit or stash first"

branch=$(git branch --show-current)
if [ "$branch" != main ] && [ $dry_run -eq 0 ]; then
  die "on branch “$branch”; releases are cut from main (or pass --dry-run)"
fi

git rev-parse -q --verify "refs/tags/$tag" >/dev/null \
  && die "tag $tag already exists locally"
if gh release view "$tag" --repo "$repo" >/dev/null 2>&1; then
  die "release $tag already exists on GitHub"
fi

gh auth status >/dev/null 2>&1 || die "gh is not authenticated"
previous_tag=$(gh release list --repo "$repo" --limit 1 --json tagName \
  --jq '.[0].tagName' 2>/dev/null || true)
security find-identity -v -p codesigning | grep -q "Developer ID Application: .*($team)" \
  || die "no Developer ID Application certificate for team $team"
[ -r "$key_path" ] || die "App Store Connect key not readable at $key_path"
[ -x "$root/scripts/make-appcast" ] || die "scripts/make-appcast is missing or not executable"

print "  branch $branch · tag $tag · team $team"
[ $dry_run -eq 1 ] && print "  dry run: nothing will be committed, pushed, or published"

# ------------------------------------------------------------ version stamp
# CFBundleVersion is what Sparkle compares, so it has to increase on every
# release even when the marketing version only gains a patch digit.

step "Stamping version"

previous_short=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$plist")
previous_build=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$plist")
build=$(( previous_build + 1 ))

restore_plist() { git checkout -- "$plist" 2>/dev/null || true }
[ $dry_run -eq 1 ] && trap restore_plist EXIT

# Edited as text rather than with PlistBuddy's Set, which rewrites the whole
# file and drops every XML comment in it. Info.plist carries the reason for the
# App Transport Security exception, and a release that silently deleted it would
# leave the next person a bare NSAllowsArbitraryLoads to wonder about.
stamp() {
  python3 - "$1" "$2" "$plist" <<'PY'
import re, sys

key, value, path = sys.argv[1], sys.argv[2], sys.argv[3]
source = open(path).read()
pattern = re.compile(
    r"(<key>" + re.escape(key) + r"</key>\s*<string>)[^<]*(</string>)"
)
stamped, count = pattern.subn(lambda m: m.group(1) + value + m.group(2), source, 1)
if count != 1:
    sys.exit(f"could not stamp {key}: matched {count} times in {path}")
open(path, "w").write(stamped)
PY
}

stamp CFBundleShortVersionString "$version"
stamp CFBundleVersion "$build"
plutil -lint "$plist" >/dev/null || die "stamping produced an invalid $plist"
print "  $previous_short (build $previous_build) → $version (build $build)"

# ------------------------------------------------------------------- build

work=$(mktemp -d "${TMPDIR:-/tmp}/little-herd-release.XXXXXX")

step "Generating project and running tests"
xcodegen generate >/dev/null
xcodebuild -project LittleHerd.xcodeproj -scheme LittleHerd test > "$work/test.log" 2>&1 || true
grep -E '✔ Test run|✘' "$work/test.log" | tail -3 || true
grep -q '\*\* TEST SUCCEEDED \*\*' "$work/test.log" \
  || die "tests failed — see $work/test.log"

archive=$work/LittleHerd.xcarchive
export_dir=$work/export
zip=$work/LittleHerd-$version.zip

step "Archiving $version"
xcodebuild -project LittleHerd.xcodeproj -scheme LittleHerd -configuration Release \
  archive -archivePath "$archive" \
  DEVELOPMENT_TEAM="$team" \
  CODE_SIGN_IDENTITY="Developer ID Application" \
  CODE_SIGN_STYLE=Manual \
  OTHER_CODE_SIGN_FLAGS="--timestamp" \
  -allowProvisioningUpdates \
  -authenticationKeyPath "$key_path" \
  -authenticationKeyID "$key_id" \
  -authenticationKeyIssuerID "$issuer" 2>&1 \
  | grep -E 'error:|\*\* ARCHIVE' || true
[ -d "$archive" ] || die "archive failed"

cat > "$work/exportOptions.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key><string>developer-id</string>
	<key>teamID</key><string>$team</string>
	<key>signingStyle</key><string>manual</string>
	<key>signingCertificate</key><string>Developer ID Application</string>
	<key>destination</key><string>export</string>
</dict>
</plist>
PLIST

step "Exporting"
xcodebuild -exportArchive -archivePath "$archive" \
  -exportOptionsPlist "$work/exportOptions.plist" \
  -exportPath "$export_dir" \
  -allowProvisioningUpdates \
  -authenticationKeyPath "$key_path" \
  -authenticationKeyID "$key_id" \
  -authenticationKeyIssuerID "$issuer" 2>&1 \
  | grep -E 'error:|\*\* EXPORT' || true

app="$export_dir/Little Herd.app"
[ -d "$app" ] || die "export failed"

# Guard against a stale generated project quietly shipping the previous
# version: what got built is the only version that matters from here on.
built_version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app/Contents/Info.plist")
[ "$built_version" = "$version" ] \
  || die "built app reports $built_version, expected $version"

# ---------------------------------------------------------------- notarize

step "Notarizing (this takes a few minutes)"
ditto -c -k --keepParent "$app" "$work/notarize.zip"
xcrun notarytool submit "$work/notarize.zip" \
  --key "$key_path" --key-id "$key_id" --issuer "$issuer" --wait \
  > "$work/notarize.log" 2>&1 || true

submission=$(grep -m1 -E '^ +id: ' "$work/notarize.log" | awk '{print $2}')
result=$(grep -m1 -E '^ +status: ' "$work/notarize.log" | awk '{print $2}')
print "  submission ${submission:-unknown} — ${result:-no status returned}"
[ "$result" = Accepted ] \
  || die "notarization returned “${result:-nothing}” — see $work/notarize.log"

xcrun stapler staple "$app" >/dev/null || die "stapling failed — see $work/notarize.log"
spctl -a -vvv -t install "$app" 2>&1 | grep -q 'source=Notarized Developer ID' \
  || die "Gatekeeper did not accept the stapled app"
print "  notarized, stapled, Gatekeeper clean"

rm -f "$work/notarize.zip"
ditto -c -k --keepParent "$app" "$zip"

# ------------------------------------------------------------------ appcast

step "Building and verifying the appcast"
appcast_args=("$zip" "$tag" --output "$work/appcast.xml")
[ -n "$notes_file" ] && appcast_args+=(--notes "$notes_file")
"$root/scripts/make-appcast" "${appcast_args[@]}"

# Catch a key mismatch here rather than after publishing: if the signature does
# not match the pinned SUPublicEDKey, every client rejects the update.
sign_update=$(find ~/Library/Developer/Xcode/DerivedData \
  -path '*artifacts/sparkle/Sparkle/bin/sign_update' 2>/dev/null | head -n 1)
[ -n "$sign_update" ] || die "sign_update not found; resolve the Sparkle package first"
signature=$(grep -o 'sparkle:edSignature="[^"]*"' "$work/appcast.xml" | cut -d'"' -f2)
"$sign_update" --verify "$zip" "$signature" \
  || die "appcast signature does not verify against the signing key"
print "  signature verifies"

if [ $dry_run -eq 1 ]; then
  print "\n✓ Dry run complete. Artifacts in $work"
  print "  Info.plist restored; nothing was committed, pushed, or published."
  exit 0
fi

# ------------------------------------------------- irreversible from here on

step "Committing and pushing"
git add "$plist" LittleHerd.xcodeproj
git commit -q -m "Little Herd $version" -m "Build $build."
git push -q origin "HEAD:$branch"
commit=$(git rev-parse HEAD)
print "  $(git rev-parse --short HEAD) pushed to $branch"

step "Publishing $tag"
if [ -n "$notes_file" ]; then
  release_body=$work/release-body.md
  cp "$notes_file" "$release_body"
  cat >> "$release_body" <<MD

## Install

Already running 0.1.2 or later? **App → Check for Updates…**, or wait for Little
Herd to offer it.

Otherwise download \`$(basename "$zip")\`, unzip, and drag **Little Herd.app**
to \`/Applications\`, replacing any earlier copy. Signed with a Developer ID
certificate and notarized by Apple. Requires macOS 15 or later.

\`appcast.xml\` is the Sparkle update feed; it is attached to every release and
is not something you need to download.
MD
  [ -n "$previous_tag" ] && printf '\n**Full changelog:** https://github.com/%s/compare/%s...%s\n' \
    "$repo" "$previous_tag" "$tag" >> "$release_body"

  gh release create "$tag" --repo "$repo" --target "$commit" \
    --title "Little Herd $version" --notes-file "$release_body" \
    "$zip#Little Herd $version (macOS, notarized)" \
    "$work/appcast.xml#Sparkle update feed"
else
  gh release create "$tag" --repo "$repo" --target "$commit" \
    --title "Little Herd $version" --generate-notes \
    "$zip#Little Herd $version (macOS, notarized)" \
    "$work/appcast.xml#Sparkle update feed"
fi

# ------------------------------------------------------------ verify it live
# The feed is only correct once GitHub is actually serving it, so check the
# published URLs the way Sparkle will rather than trusting the local files.

step "Verifying the published feed"
feed=https://github.com/$repo/releases/latest/download/appcast.xml
live=$work/live-appcast.xml
feed_status=$(curl -sL -o "$live" -w '%{http_code}' "$feed")
[ "$feed_status" = 200 ] \
  || die "feed returned HTTP $feed_status — updates are broken"
grep -q "<sparkle:shortVersionString>$version<" "$live" \
  || die "feed does not advertise $version"
enclosure=$(grep -o 'url="[^"]*"' "$live" | head -1 | cut -d'"' -f2)
enclosure_status=$(curl -sIL -o /dev/null -w '%{http_code}' "$enclosure")
[ "$enclosure_status" = 200 ] || die "enclosure returned HTTP $enclosure_status"
if [ -n "$notes_file" ]; then
  grep -q 'sparkle:descriptionFormat="html"' "$live" \
    || die "published feed carries no release notes"
fi

print "\n✓ Little Herd $version (build $build) released"
print "  https://github.com/$repo/releases/tag/$tag"
print "  feed serves $version and its download resolves"
print "\n  Artifacts kept in $work"
print "  Your own copy is not updated by this script; Sparkle will offer it,"
print "  or install $zip by hand."
